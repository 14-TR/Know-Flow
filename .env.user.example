# Know-Flow User Configuration
# Copy this file to .env and edit the values below

# Your username (appears in /api/whoami)
KNOWFLOW_USER=alice

# Path to the shared admin templates on your network
#
# Windows (UNC path):
#   ADMIN_SHARE_PATH=//SERVER/KnowFlow/admin
#
# Windows (mapped drive):
#   ADMIN_SHARE_PATH=Z:/KnowFlow/admin
#
# Mac (SMB mount):
#   ADMIN_SHARE_PATH=/Volumes/KnowFlow/admin
#
# Linux (NFS/SMB mount):
#   ADMIN_SHARE_PATH=/mnt/shared/knowflow/admin
#
ADMIN_SHARE_PATH=/path/to/network/share/admin

# Local folder for your projects (optional, defaults to ./data)
# Windows: LOCAL_DATA_DIR=C:/Users/YourName/KnowFlow
# Mac:     LOCAL_DATA_DIR=/Users/yourname/KnowFlow
# Linux:   LOCAL_DATA_DIR=/home/yourname/knowflow
# LOCAL_DATA_DIR=
